# Copiar a .env y ajustar. Las variables de entorno del sistema pisan estos valores.
# El servidor HTTP y el stream viven en: go run ./cmd/server
# La prueba de estrés de 100 bloques sigue en: go run ./cmd/demo

PORT=8080

# Bits de trabajo del PoW. Solo cuentan los múltiplos de 8 (cada 8 bits = un byte cero).
# 16 es un valor cómodo para ver bloques en la interfaz. 24 alarga cada ronda.
DIFFICULTY=16

# Satoshis existentes. No es la longitud de la cadena: seleccionar un satoshi no lo consume.
INITIAL_SUPPLY=1000

# Bloques totales de una generación, génesis incluido. Alturas 0..MAX_BLOCKS-1.
# Tiene que ser >= 3. El reinicio deja solo el génesis y el minado sigue hasta este tope.
# 1000 bloques de demo no equivalen a 1000 satoshis.
MAX_BLOCKS=1000

# Orígenes del frontend que pueden llamar a la API y abrir el EventSource.
# Separados por coma. Usar * solo si el despliegue lo necesita.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pausa tras cada bloque verificado, antes de minar el siguiente.
BLOCK_INTERVAL_MS=2000
